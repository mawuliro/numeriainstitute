// Numeria Institute — Prisma schema
// Full data model adapted from the Django app to Prisma/Next.js

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(STUDENT)
  isVerified    Boolean   @default(false)
  avatarUrl     String?
  bio           String?
  preferredLanguage String @default("fr")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  exerciseProgress ExerciseProgress[]
  labProgress      LabProgress[]
  payments         Payment[]
  notifications    Notification[]
  blogPosts        BlogPost[]
  communityTopics  CommunityTopic[]
  communityPosts   CommunityPost[]
  mentorProfile    MentorProfile?
  menteeProfile    MenteeProfile?
}

enum UserRole {
  STUDENT
  MENTOR
  STAFF
  ADMIN
}

// ─────────────────────────────────────────────────────────────────────────────
// Courses
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String
  shortDescription String?
  category        String        @default("physique")
  level           CourseLevel   @default(DEBUTANT)
  language        String        @default("fr")
  price           Int           @default(0)
  isFree          Boolean       @default(true)
  status          CourseStatus  @default(PUBLISHED)
  estimatedHours  Int           @default(40)
  thumbnailUrl    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  modules     CourseModule[]
  lessons     CourseLesson[]
  enrollments Enrollment[]

  @@index([slug])
  @@index([status])
}

enum CourseLevel {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId])
}

model CourseLesson {
  id               String   @id @default(cuid())
  courseId          String
  moduleId          String
  title            String
  slug             String
  order            Int      @default(0)
  estimatedMinutes Int      @default(30)
  isFreePreview    Boolean  @default(true)
  isActive         Boolean  @default(true)

  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module  CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks  LessonBlock[]
  progress LessonProgress[]
  mcqExercises      MCQExercise[]
  fillBlankExercises FillBlankExercise[]
  trueFalseExercises TrueFalseExercise[]
  codeExercises     CodeExercise[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([moduleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lesson blocks (polymorphic — only one of the exercise FKs is set)
// ─────────────────────────────────────────────────────────────────────────────

model LessonBlock {
  id           String     @id @default(cuid())
  lessonId      String
  blockType    BlockType
  order        Int        @default(0)
  textContent  String?

  // Sandbox blocks
  sandboxTitle         String?
  sandboxInitialCode   String?

  // Exercise FKs (exactly one set when blockType matches)
  mcqId           String? @unique
  fillBlankId     String? @unique
  trueFalseId     String? @unique
  codeExerciseId  String? @unique
  interactiveLabId String? @unique

  lesson     CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mcq        MCQExercise?    @relation(fields: [mcqId], references: [id], onDelete: Cascade)
  fillBlank  FillBlankExercise? @relation(fields: [fillBlankId], references: [id], onDelete: Cascade)
  trueFalse  TrueFalseExercise? @relation(fields: [trueFalseId], references: [id], onDelete: Cascade)
  codeEx     CodeExercise?   @relation(fields: [codeExerciseId], references: [id], onDelete: Cascade)
  lab        InteractiveLab? @relation(fields: [interactiveLabId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

enum BlockType {
  TEXT
  SANDBOX
  MCQ
  FILL_BLANK
  TRUE_FALSE
  CODE_EXERCISE
  INTERACTIVE_LAB
}

// ─────────────────────────────────────────────────────────────────────────────
// Exercise types
// ─────────────────────────────────────────────────────────────────────────────

model MCQExercise {
  id               String   @id @default(cuid())
  lessonId         String
  title            String
  question         String
  instructions     String   @default("")
  difficulty       String   @default("easy")
  points           Int      @default(5)
  hint             String   @default("")
  explanation      String   @default("")
  allowMultiple    Boolean  @default(false)
  shuffleChoices   Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  choices MCQChoice[]
  block   LessonBlock?

  @@index([lessonId])
}

model MCQChoice {
  id         String  @id @default(cuid())
  exerciseId String
  text       String
  isCorrect  Boolean @default(false)
  feedback   String  @default("")
  order      Int     @default(0)

  exercise MCQExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model FillBlankExercise {
  id              String   @id @default(cuid())
  lessonId        String
  title           String
  instructions    String   @default("")
  difficulty      String   @default("easy")
  points          Int      @default(5)
  hint            String   @default("")
  explanation     String   @default("")
  textWithBlanks  String
  answersJson     String   // JSON-encoded { "blank_1": ["val1", "val2"], ... }
  caseSensitive   Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  block  LessonBlock?

  @@index([lessonId])
}

model TrueFalseExercise {
  id            String   @id @default(cuid())
  lessonId      String
  title         String
  instructions  String   @default("")
  difficulty    String   @default("easy")
  points        Int      @default(6)
  hint          String   @default("")
  explanation   String   @default("")
  statementsJson String   // JSON-encoded [{ statement, is_true, statement_note? }, ...]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  block  LessonBlock?

  @@index([lessonId])
}

model CodeExercise {
  id             String   @id @default(cuid())
  lessonId       String
  title          String
  instructions   String   @default("")
  difficulty     String   @default("medium")
  points         Int      @default(10)
  hint           String   @default("")
  explanation    String   @default("")
  starterCode    String   @default("")
  solution       String   @default("")
  expectedOutput String   @default("")
  testCode       String   @default("")
  language       String   @default("python")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  block  LessonBlock?

  @@index([lessonId])
}

model InteractiveLab {
  id              String   @id @default(cuid())
  title           String
  instructions    String   @default("")
  simulationCode  String   // Python code defining simulate(params) -> matplotlib Figure
  sliderConfigJson String   // JSON [{ name, label, min, max, step, default, unit }]
  challengesJson  String   // JSON [{ id, question, expected_value, tolerance, unit, hint, explanation, next_on_correct, next_on_wrong }]
  points          Int      @default(20)
  difficulty      String   @default("medium")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  block     LessonBlock?
  progress  LabProgress[]

  @@index([title])
}

// ─────────────────────────────────────────────────────────────────────────────
// Progress tracking
// ─────────────────────────────────────────────────────────────────────────────

model Enrollment {
  id        String   @id @default(cuid())
  userId     String
  courseId   String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId       String
  lessonId     String
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model ExerciseProgress {
  id            String   @id @default(cuid())
  userId         String
  exerciseType   String   // 'mcq', 'fill_blank', 'true_false', 'code', 'lab'
  exerciseId     String
  isSolved       Boolean  @default(false)
  attemptsUsed   Int      @default(0)
  lastAnswer     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseType, exerciseId])
  @@index([userId])
}

model LabProgress {
  id                  String   @id @default(cuid())
  userId               String
  labId                String
  currentChallengeId   String   @default("")
  challengesSolvedJson String   @default("[]") // JSON array of challenge IDs
  attempts             Int      @default(0)
  isCompleted          Boolean  @default(false)
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  InteractiveLab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@index([userId])
  @@index([labId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id           String   @id @default(cuid())
  userId        String
  amount        Int      // in cents
  currency      String   @default("EUR")
  status        String   @default("en_cours") // en_cours, reussi, echoue
  provider      String   @default("stripe")
  referenceProvider String?
  courseId      String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId     String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Blog & Community
// ─────────────────────────────────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverUrl    String?
  authorId     String
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
}

model CommunityTopic {
  id          String   @id @default(cuid())
  title       String
  categoryId  String
  authorId     String
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts  CommunityPost[]

  @@index([categoryId])
}

model CommunityPost {
  id        String   @id @default(cuid())
  topicId   String
  authorId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Mentorat
// ─────────────────────────────────────────────────────────────────────────────

model MentorProfile {
  id          String   @id @default(cuid())
  userId       String   @unique
  bio         String
  expertise   String   // JSON array of subjects
  hourlyRate  Int      // in cents
  isAvailable Boolean  @default(true)
  rating      Float    @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenteeProfile {
  id          String   @id @default(cuid())
  userId       String   @unique
  goals       String
  level       String   @default("debutant")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
